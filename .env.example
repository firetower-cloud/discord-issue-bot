# --- required ---------------------------------------------------------------
# Discord bot token. Enable the MESSAGE CONTENT INTENT on the bot, or it will
# connect fine and then read every message as empty.
DISCORD_TOKEN=
# Used to draft the title, labels and summary.
OPENAI_API_KEY=
# Fine-grained PAT with Issues: read & write on the target repo (or classic PAT
# with `repo`).
GITHUB_TOKEN=

# Where issues are filed. One of these two must be set.
GITHUB_REPO=owner/repo
# Optional per-server overrides, so one deployment can serve several servers.
# GITHUB_REPO_MAP={"1234567890": "owner/other-repo"}

# --- optional ---------------------------------------------------------------
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Restrict who can file issues. Unset means anyone in the server can.
# ALLOWED_ROLE_IDS=1234567890,9876543210

# Guard rails. Defaults shown; lower them if you are cost-sensitive.
# MAX_THREAD_MESSAGES=200
# MAX_MESSAGE_CHARS=2000
# MAX_LLM_CHARS=24000
# MAX_BODY_CHARS=60000
# MAX_ATTACHMENTS=20
# USER_COOLDOWN_SECS=20

# PORT=8080
# RUST_LOG=discord_issue_bot=info,serenity=warn
